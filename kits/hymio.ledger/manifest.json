{
  "schema": "hymio.kit/v1",
  "id": "hymio.ledger",
  "version": "0.2.0",
  "display": {
    "name": "生活账本",
    "tagline": "把每一笔花费，变成一眼看懂的生活节奏。",
    "description": "记录日常支出，查看本月趋势、分类构成和最近记录。",
    "category": "生活",
    "icon": "wallet",
    "accent": "amber"
  },
  "api": {
    "transport": "bundled",
    "handler": "kit_host.builtin_ledger:LedgerKit"
  },
  "operations": [
    {
      "id": "entries.create",
      "agent_visible": true,
      "name": "记一笔",
      "description": "记录一笔支出。金额单位为人民币元。",
      "effect": "write",
      "timeout_ms": 10000,
      "input_schema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000,
            "description": "Expense amount in CNY yuan"
          },
          "category": {
            "type": "string",
            "enum": ["food", "transport", "learning", "life", "other"],
            "description": "Use other only when none of the named categories fit"
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "occurred_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Local calendar date as YYYY-MM-DD"
          }
        },
        "required": ["amount"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "entry": {"type": "object"},
          "summary": {"type": "object"}
        }
      }
    },
    {
      "id": "entries.list",
      "agent_visible": true,
      "name": "查看最近记录",
      "description": "列出当前用户最近的支出记录。",
      "effect": "read",
      "timeout_ms": 5000,
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 30}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {"type": "array"},
          "summary": {"type": "object"}
        }
      }
    },
    {
      "id": "summary",
      "agent_visible": true,
      "name": "查看本月汇总",
      "description": "返回本月支出总额和记录数。",
      "effect": "read",
      "timeout_ms": 5000,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "month": {"type": "string"},
          "total": {"type": "number"},
          "count": {"type": "integer"}
        }
      }
    }
  ],
  "preview": true,
  "app": {
    "mode": "interactive",
    "bridge": "hymio.kit.bridge/v1",
    "entry": "web/index.html"
  }
}
